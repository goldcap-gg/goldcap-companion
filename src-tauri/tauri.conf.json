{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GoldCap Companion",
  "version": "1.0.0",
  "identifier": "gg.goldcap.companion",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
