{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capabilities for the main window — the app is tray-only otherwise, opening this window on its own only on first run, when the config is incomplete.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "core:window:allow-hide",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://goldcap.gg/*" }]
    }
  ]
}
